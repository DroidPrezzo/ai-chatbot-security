# Copy to .env.local for `npm run dev`, or use with `docker compose`.
# (.env.local and .env are gitignored.)

# ─── LLM backend ─────────────────────────────────────────────────
# Local Ollama default. If you run the Saffev observability proxy, point
# this at it instead (e.g. http://localhost:8088). Under Docker Compose use
# http://host.docker.internal:11434 to reach Ollama on the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
SYSTEM_PROMPT=You are a helpful AI assistant. Respond concisely and accurately.

# ─── Attack server ───────────────────────────────────────────────
ATTACK_SERVER_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ─── Rate limiting ───────────────────────────────────────────────
RATE_LIMIT_MAX=30            # /api/chat requests per minute per IP
ATTACK_RATE_LIMIT_MAX=10     # /run-attacks requests per minute per IP

# ─── Attack server performance ───────────────────────────────────
# Keep the model resident in VRAM between calls ("-1" = never unload).
OLLAMA_KEEP_ALIVE=30m
# How many scenarios may call the model at once. Raise it (e.g. 6) if your
# Ollama is configured with OLLAMA_NUM_PARALLEL>=6 and has the VRAM.
MAX_CONCURRENT_SCENARIOS=3
# Per-call model timeout (seconds) before a scenario reports "unavailable".
OLLAMA_TIMEOUT_SECONDS=60
# Cap generated tokens per scenario (bounds worst-case latency).
OLLAMA_NUM_PREDICT=512
